// Prisma Schema for RRJ Roofing & Construction, LLC
// Compatible with PostgreSQL (Supabase / Neon / Vercel Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum UrgencyLevel {
  STANDARD
  EMERGENCY_STORM
}

enum ContactMethod {
  PHONE
  EMAIL
  SMS
}

enum RoofType {
  ASPHALT_SHINGLE
  STANDING_SEAM_METAL
  COMMERCIAL_TPO_FLAT
  TILE_SLATE
  OTHER_UNKNOWN
}

enum ProjectCategory {
  RESIDENTIAL_SHINGLE
  STANDING_SEAM_METAL
  COMMERCIAL_FLAT
  STORM_DAMAGE_REPAIR
  CUSTOM_ACCENTS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookingsHandled Booking[]
  auditLogs       AuditLog[]
}

model Service {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  shortDescription  String
  longDescription   String       @db.Text
  image             String
  icon              String
  category          String
  estimatedDuration Int          @default(45) // In minutes
  priceNote         String       @default("Free Inspection & Written Estimate")
  displayOrder      Int          @default(0)
  active            Boolean      @default(true)
  whatsIncluded     String[]
  processSteps      Json         // Array of { stepNumber, title, description }
  faqs              Json         // Array of { question, answer }
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  bookings          Booking[]
}

model Customer {
  id             String    @id @default(cuid())
  fullName       String
  email          String    @unique
  phone          String
  address        String
  preferredContact ContactMethod @default(PHONE)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  referenceNumber String        @unique
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  date            String        // YYYY-MM-DD in America/Chicago
  time            String        // HH:mm in America/Chicago
  urgency         UrgencyLevel  @default(STANDARD)
  roofType        RoofType      @default(ASPHALT_SHINGLE)
  stormDetails    String?       @db.Text
  notes           String?       @db.Text
  internalNotes   String?       @db.Text
  status          BookingStatus @default(PENDING)
  managementToken String        @unique @default(cuid())
  photos          BookingPhoto[]
  assignedToId    String?
  assignedTo      User?         @relation(fields: [assignedToId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([date, time])
  @@index([status])
  @@index([urgency])
}

model BookingPhoto {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  uploadedAt DateTime @default(now())
}

model Project {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  category     ProjectCategory
  location     String          // Fort Worth, Keller, Arlington, etc.
  description  String          @db.Text
  beforeImage  String
  afterImage   String
  completedAt  String          // e.g. "October 2026"
  shingleType  String?
  colorName    String?
  featured     Boolean         @default(false)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique // 0=Sunday, 1=Monday ... 6=Saturday
  isOpen    Boolean  @default(true)
  openTime  String   @default("07:00") // HH:mm in Chicago
  closeTime String   @default("18:00")
  slotMinutes Int    @default(60)
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD
  reason    String
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  location   String
  rating     Int      @default(5)
  headline   String
  comment    String   @db.Text
  service    String
  date       String
  verified   Boolean  @default(true)
  featured   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  subject   String
  message   String   @db.Text
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  timestamp DateTime @default(now())
}

model SiteSetting {
  id              String   @id @default("singleton")
  businessName    String   @default("RRJ Roofing & Construction, LLC")
  phone           String   @default("(817) 734-7717")
  email           String   @default("rrjroofings@gmail.com")
  address         String   @default("4466 Hardy St, Fort Worth, TX 76106, USA")
  emergencyNotice String?
  timezone        String   @default("America/Chicago")
  updatedAt       DateTime @updatedAt
}
